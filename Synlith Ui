                local cfgs = Library:GetConfigs()
                local clean = {} for _,c in ipairs(cfgs) do if c~=n then table.insert(clean, c) end end
                cfgDrop:Refresh(clean)
            else Library:Notify("Error", "Select config") end 
        end)

