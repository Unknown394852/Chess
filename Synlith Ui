                local distLbl = I("TextLabel", {AnchorPoint=Vector2.new(0.5,0), Position=UDim2.new(0.5,0,1,2), Size=UDim2.new(0,100,0,12), BackgroundTransparency=1, Text="25m", TextSize=10, FontFace=F_NUM, TextColor3=Color3.new(1,1,1), Parent=box, ZIndex=26})
                local wpnLbl = I("TextLabel", {AnchorPoint=Vector2.new(0.5,0), Position=UDim2.new(0.5,0,1,14), Size=UDim2.new(0,100,0,12), BackgroundTransparency=1, Text="Weapon", TextSize=10, FontFace=F_TEXT, TextColor3=Color3.new(0.8,0.8,0.8), Parent=box, ZIndex=26})
                
                local function drawLine(p1, p2)
                    local dist = (p2 - p1).Magnitude
                    local center = (p1 + p2) / 2
                    local line = I("Frame", {AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.new(0, center.X, 0, center.Y), Size=UDim2.new(0, dist, 0, 1), BackgroundColor3=skelCol, BorderSizePixel=0, Rotation=math.deg(math.atan2(p2.Y - p1.Y, p2.X - p1.X)), Parent=skelWrap})
                    return line
                end
                
                local skelLines = {}
                local head = Vector2.new(35, 16)
                local neck = Vector2.new(35, 26)
                local pelvis = Vector2.new(35, 68)
                local lShoulder = Vector2.new(22, 26)
                local rShoulder = Vector2.new(48, 26)
                local lHand = Vector2.new(18, 60)
                local rHand = Vector2.new(52, 60)
                local lKnee = Vector2.new(29, 90)
                local rKnee = Vector2.new(41, 90)
                local lFoot = Vector2.new(29, 113)
                local rFoot = Vector2.new(41, 113)
                
                table.insert(skelLines, drawLine(head, neck))
                table.insert(skelLines, drawLine(neck, pelvis))
                table.insert(skelLines, drawLine(neck, lShoulder))
                table.insert(skelLines, drawLine(lShoulder, lHand))
                table.insert(skelLines, drawLine(neck, rShoulder))
                table.insert(skelLines, drawLine(rShoulder, rHand))
                table.insert(skelLines, drawLine(pelvis, lKnee))
                table.insert(skelLines, drawLine(lKnee, lFoot))
                table.insert(skelLines, drawLine(pelvis, rKnee))
                table.insert(skelLines, drawLine(rKnee, rFoot))
                
                box.Position = UDim2.new(0, 16, 0, 10)
                box.Size = UDim2.new(0, 48, 0, 90)
                
                local obj = {
                    Box = box, BoxOutline = boxStk, HealthBarBg = hpBg, HealthBar = hpFill, Name = nameLbl, Distance = distLbl, Weapon = wpnLbl, Skeleton = skelWrap, SkelLines = skelLines,
                    Update = function(self, settings)
                        if settings.BoxVisible ~= nil then self.BoxOutline.Transparency = settings.BoxVisible and 0 or 1 end
                        if settings.BoxColor ~= nil then self.BoxOutline.Color = settings.BoxColor end
                        if settings.HealthBarVisible ~= nil then self.HealthBarBg.Visible = settings.HealthBarVisible end
                        if settings.NameVisible ~= nil then self.Name.Visible = settings.NameVisible end
                        if settings.NameColor ~= nil then self.Name.TextColor3 = settings.NameColor end
                        if settings.DistanceVisible ~= nil then self.Distance.Visible = settings.DistanceVisible end
                        if settings.DistanceColor ~= nil then self.Distance.TextColor3 = settings.DistanceColor end
                        if settings.WeaponVisible ~= nil then self.Weapon.Visible = settings.WeaponVisible end
                        if settings.WeaponColor ~= nil then self.Weapon.TextColor3 = settings.WeaponColor end
                        if settings.SkeletonVisible ~= nil then self.Skeleton.Visible = settings.SkeletonVisible end
                        if settings.SkeletonColor ~= nil then for _, l in ipairs(self.SkelLines) do l.BackgroundColor3 = settings.SkeletonColor end end
                    end
                }
                return obj
            end
            
            return SO
        end
        table.insert(WO._tabs, TO) return TO
    end
    
    local function CreateDefaults(WO)
