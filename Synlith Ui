            local url = Library._bgUrlBox:Get()
            if url ~= "" then
                local icon = GetIcon(url)
                if icon ~= "" then Library:SetBackground(url, Library._bgTintTgl:Get()) else Library:Notify("Invalid Input", "Must be a valid image URL") end
