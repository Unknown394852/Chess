    task.defer(function()
        CreateDefaults(WO)
        if WO._tabs[1] then WO._tabs[1]:Activate() end
    end)
    
    pcall(function() local ac=self:GetAutoConfig() if ac~="" then task.delay(0.5,function() self:LoadConfig(ac,true) end) end end)
