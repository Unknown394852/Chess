local function FetchAsset(url, path)
    pcall(function()
        if not isfolder("Synlith.hub") then makefolder("Synlith.hub") end
        if not isfile(path) then
            local data = game:HttpGet(url)
            local isPng = data:sub(1, 4) == "\137PNG"
            local isJpg = data:sub(1, 3) == "\255\216\255"
            local isGif = data:sub(1, 4) == "GIF8"
            local isWebp = data:sub(1, 4) == "RIFF" and data:sub(9, 12) == "WEBP"
            if isPng or isJpg or isGif or isWebp then
                writefile(path, data)
            end
        end
    end)
    local img=""
    pcall(function() if isfile(path) then img=getcustomasset(path) end end)
    return img
end

local function GetIcon(id)
    if not id or id == "" then return "" end
    if tonumber(id) then 
        return "rbxassetid://"..id 
    elseif type(id) == "string" then
        id = id:gsub("^%s*(.-)%s*$", "%1") -- trim spaces
        if id:sub(1,4) == "http" then
            local fetchUrl = id
            if not (id:match("discordapp%.com") or id:match("discord%.net") or id:match("discordapp%.net")) then
                fetchUrl = id:split("?")[1] or id
            end
            local cleanUrl = fetchUrl:split("?")[1] or fetchUrl
            
            local hash = 5381
            for i=1,#cleanUrl do hash = (hash * 33 + string.byte(cleanUrl, i)) % 4294967296 end
            
            local ext = cleanUrl:match("%.(%w+)$") or "png"
            if not ext:match("^%w+$") then ext = "png" end
            local path = "Synlith.hub/"..tostring(hash).."."..ext
            return FetchAsset(fetchUrl, path)
        elseif id:sub(1,13) == "rbxassetid://" or id:sub(1,17) == "rbxgameasset://" or id:match("asset://") then
            return id
        end
    end
    return ""
end
