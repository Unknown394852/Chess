        local line1 = I("Frame", {Position=UDim2.new(0,4,0,62), Size=UDim2.new(1,-8,0,1), BackgroundTransparency=0.5, Parent=dash, ZIndex=13}) Thm(line1, "BackgroundColor3", "Border")
        
        local exec = "Unknown" pcall(function() exec = identifyexecutor() end)
        local execLbl = I("TextLabel", {Position=UDim2.new(0,4,0,74), Size=UDim2.new(1,0,0,14), BackgroundTransparency=1, Text="Executor: "..tostring(exec), TextSize=11, FontFace=F_TEXT, TextXAlignment=Enum.TextXAlignment.Left, Parent=dash, ZIndex=16}) Thm(execLbl, "TextColor3", "TextDark")
        
        local sessLbl = I("TextLabel", {Position=UDim2.new(0,4,0,92), Size=UDim2.new(1,0,0,14), BackgroundTransparency=1, Text="Session: 00:00:00", TextSize=11, FontFace=F_NUM, TextXAlignment=Enum.TextXAlignment.Left, Parent=dash, ZIndex=16}) Thm(sessLbl, "TextColor3", "TextDark")
        local sStart = os.time()
        
        local fpsLbl = I("TextLabel", {Position=UDim2.new(0,4,0,110), Size=UDim2.new(0,100,0,14), BackgroundTransparency=1, Text="FPS: 0", TextSize=11, FontFace=F_NUM, TextXAlignment=Enum.TextXAlignment.Left, Parent=dash, ZIndex=16}) Thm(fpsLbl, "TextColor3", "TextDark")
        local pingLbl = I("TextLabel", {Position=UDim2.new(0,110,0,110), Size=UDim2.new(0,100,0,14), BackgroundTransparency=1, Text="Ping: 0 ms", TextSize=11, FontFace=F_NUM, TextXAlignment=Enum.TextXAlignment.Left, Parent=dash, ZIndex=16}) Thm(pingLbl, "TextColor3", "TextDark")
        
        local line2 = I("Frame", {Position=UDim2.new(0,4,0,132), Size=UDim2.new(1,-8,0,1), BackgroundTransparency=0.5, Parent=dash, ZIndex=13}) Thm(line2, "BackgroundColor3", "Border")
        
        local com = I("Frame", {Position=UDim2.new(0,4,0,144), Size=UDim2.new(1,-8,0,32), BackgroundTransparency=1, Parent=dash, ZIndex=16})
        local dI = I("ImageLabel", {Position=UDim2.new(0,4,0.5,-10), Size=UDim2.new(0,20,0,20), BackgroundTransparency=1, ScaleType=Enum.ScaleType.Fit, Parent=com, ZIndex=16}) 
        pcall(function() local li=FetchAsset(DURL,DPATH) if li~="" then dI.Image=li end end) 
        Library._dcLogo = dI
        
        local cpB = I("TextButton", {Position=UDim2.new(0,32,0.5,-12), Size=UDim2.new(0,140,0,24), Text="COPY DISCORD INVITE", TextSize=10, FontFace=F_TITLE, Parent=com, ZIndex=17}) Thm(cpB, "BackgroundColor3", "Element") Thm(cpB, "TextColor3", "Text") Crn(cpB, 4) Stk(cpB, "Border", 1, 0.2)
        Cn(cpB.MouseButton1Click, function() pcall(function() setclipboard(DINV) end) cpB.Text="COPIED" task.delay(1.5, function() cpB.Text="COPY DISCORD INVITE" end) Library:Notify("Discord", "Copied to clipboard") end)

        local frames, lastTick = 0, tick()
        Cn(Run.RenderStepped, function()
            frames = frames + 1
            if tick() - lastTick >= 1 then
                local fps = frames
                frames = 0
                lastTick = tick()
                local ping = 0
                pcall(function() ping = math.floor(LP:GetNetworkPing() * 1000) end)
                if ping == 0 then pcall(function() ping = math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()) end) end
                if fpsLbl and fpsLbl.Parent then fpsLbl.Text = "FPS: "..fps end
                if pingLbl and pingLbl.Parent then pingLbl.Text = "Ping: "..ping.." ms" end
                if sessLbl and sessLbl.Parent then local t=os.time()-sStart sessLbl.Text=string.format("Session: %02d:%02d:%02d", math.floor(t/3600), math.floor((t%3600)/60), t%60) end
            end
        end)

        local setTab = WO:CreateTab({Name="Settings", Icon=ICONS.Settings}) setTab._btn.LayoutOrder=998
        
        -- BALANCED LAYOUT: Left (Themes + Custom), Right (Interface + Config)
        local thmSec = setTab:CreateSection("Themes", "Left")
        local tGrid = I("Frame", {Size=UDim2.new(1,0,0,98), BackgroundTransparency=1, Parent=thmSec._c, ZIndex=15}) I("UIGridLayout", {CellSize=UDim2.new(0.5,-4,0,24), CellPadding=UDim2.new(0,8,0,4), SortOrder=Enum.SortOrder.LayoutOrder, Parent=tGrid})
        local tNames = {"Darkness","Midnight","Fatality","Aurora","BloodMoon","Cyberpunk"}
        for i,tn in ipairs(tNames) do local td=Library.Themes[tn] if td then local tb=I("TextButton",{Text="",LayoutOrder=i,Parent=tGrid,ZIndex=16}) Thm(tb,"BackgroundColor3","Element") Crn(tb,4) Stk(tb,"Border",1,0.2) local cSq=I("Frame",{Position=UDim2.new(0,6,0.5,-5),Size=UDim2.new(0,10,0,10),BackgroundColor3=td.Background,Parent=tb,ZIndex=17}) Crn(cSq,3) I("UIStroke",{Color=td.Accent,Thickness=1,Parent=cSq}) I("TextLabel",{Position=UDim2.new(0,24,0,0),Size=UDim2.new(1,-24,1,0),BackgroundTransparency=1,Text=tn:upper(),TextSize=9,FontFace=F_TITLE,TextXAlignment=Enum.TextXAlignment.Left,Parent=tb,ZIndex=17}) Thm(tb:FindFirstChildOfClass("TextLabel"),"TextColor3","TextDark") Cn(tb.MouseButton1Click,function() Library:SetTheme(tn) end) Cn(tb.MouseEnter,function() Tw(tb,{BackgroundColor3=Library.Theme.ElementHover},TF) Thm(tb:FindFirstChildOfClass("TextLabel"),"TextColor3","Text") end) Cn(tb.MouseLeave,function() Tw(tb,{BackgroundColor3=Library.Theme.Element},TF) Thm(tb:FindFirstChildOfClass("TextLabel"),"TextColor3","TextDark") end) end end

        local ctSec = setTab:CreateSection("Custom Theme", "Left")
        local cT = Library.Themes["Custom"]
        
        ctSec:CreateColorPicker({Name="Background", Default=cT.Background, Callback=function(v) 
            local h, s, vl = Color3.toHSV(v)
            -- Apply intelligent clamping to keep the UI dark and readable
            local s_mod = math.clamp(s * 0.45, 0, 0.3)
            local v_mod = math.clamp(vl * 0.35, 0.04, 0.16)
            local bg = Color3.fromHSV(h, s_mod, v_mod)
            cT.Background = bg
            cT.Panel = Color3.fromHSV(h, s_mod, math.clamp(v_mod + 0.02, 0, 1))
            cT.Section = Color3.fromHSV(h, s_mod, math.clamp(v_mod + 0.04, 0, 1))
            cT.Element = Color3.fromHSV(h, s_mod, math.clamp(v_mod + 0.07, 0, 1))
            cT.ElementHover = Color3.fromHSV(h, s_mod, math.clamp(v_mod + 0.10, 0, 1))
            cT.Border = Color3.fromHSV(h, s_mod, math.clamp(v_mod + 0.15, 0, 1))
        end})
        ctSec:CreateColorPicker({Name="Accent", Default=cT.Accent, Callback=function(v) cT.Accent=v cT.Logo=v end})
        ctSec:CreateColorPicker({Name="Text", Default=cT.Text, Callback=function(v) 
            cT.Text=v 
            local luma = v.R*0.299 + v.G*0.587 + v.B*0.114 
            local tgt = (luma > 0.5) and Color3.new(0,0,0) or Color3.new(1,1,1) 
            cT.TextDark = v:Lerp(tgt, 0.4) 
        end})
        ctSec:CreateColorPicker({Name="Icons", Default=cT.Icon, Callback=function(v) cT.Icon=v end})
        ctSec:CreateButton({Name="Apply Custom Theme", Callback=function() Library:SetTheme("Custom") Library:SaveCustomTheme() end})
        
        -- RIGHT SIDE OF SETTINGS
        local function cBtn(parent, txt, cb)
            local b = I("TextButton", {Size=UDim2.new(1,0,1,0), Text="", Parent=parent, ZIndex=16}) Thm(b, "BackgroundColor3", "Element") Crn(b, 4) 
            local lb = I("TextLabel", {Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, Text=txt:upper(), TextSize=10, FontFace=F_TITLE, Parent=b, ZIndex=17}) Thm(lb, "TextColor3", "Text")
            Cn(b.MouseButton1Click, function() Ripple(b) cb() end)
            Cn(b.MouseEnter, function() Tw(b, {BackgroundColor3=Library.Theme.ElementHover}, TF) end)
            Cn(b.MouseLeave, function() Tw(b, {BackgroundColor3=Library.Theme.Element}, TF) end)
            return b
        end

        local uiSec = setTab:CreateSection("Interface", "Right")
        uiSec:CreateKeybind({Name="Toggle Menu", Default=Library.ToggleKey, Flag="_SynTK", Callback=function() end})
        Cn(UIS.InputBegan,function() local tk=Library.Flags["_SynTK"] if tk and typeof(tk)=="EnumItem" then Library.ToggleKey=tk if Library.tkLbl then Library.tkLbl.Text="Toggle UI: ["..tk.Name.."]" end end end)
        
        uiSec:CreateToggle({Name="Show Background Image", Default=true, Flag="_SynBgVis", Callback=function(v)
            Library.ShowBackground = v
            if Library._wmBgI then Library._wmBgI.Visible = v end
            if Library._kbBgI then Library._kbBgI.Visible = v end
            if Library._uiBgI then Library._uiBgI.Visible = v end
            if Library._notifBgs then for _, nb in ipairs(Library._notifBgs) do nb.Visible = v end end
        end})
        uiSec:CreateToggle({Name="Show Particles", Default=true, Flag="_SynPtcVis", Callback=function(v)
            Library.ShowParticles = v
            for _, ptc in ipairs(Library._particleWraps or {}) do ptc.Visible = v end
        end})
        uiSec:CreateToggle({Name="Show Watermark (When UI Hidden)", Default=Library.ShowWatermark, Flag="_SynWM", Callback=function(v) Library.ShowWatermark=v if Library._wm then if Library.Open then Library._wm.Visible=false else Library._wm.Visible=v end end end})
        uiSec:CreateButton({Name="Unload Script", Callback=function() Library:Unload() end})

        -- FLAWLESS SELECTOR CONFIG SYSTEM
