            if part.Name:find("Arm") then
                part.Material = armMat
                part.Color = armColor
            else
                part.Material = gunMat
                part.Color = gunColor
            end
        end
    end
end

-- // ESP
local function clearESP(player)
    local data = ESPDrawings[player]
    if data then
        for _, obj in pairs(data) do
            if typeof(obj) == "Instance" then
                obj:Destroy()
            elseif type(obj) == "table" and obj.Remove then
                obj:Remove()
            end
        end
        ESPDrawings[player] = nil
    end
    if ESPHighlights[player] then
        ESPHighlights[player]:Destroy()
        ESPHighlights[player] = nil
    end
end

local function createDrawing(typeName, props)
    if not Drawing then return nil end
    local d = Drawing.new(typeName)
    for k, v in pairs(props) do
        d[k] = v
    end
    d.Visible = false
    return d
end

local function ensureESP(player)
    if ESPDrawings[player] then return ESPDrawings[player] end
    ESPDrawings[player] = {
        Box = createDrawing("Square", { Thickness = 1, Filled = false }),
        Tracer = createDrawing("Line", { Thickness = 1 }),
        Name = createDrawing("Text", { Size = 14, Center = true, Outline = true }),
        Distance = createDrawing("Text", { Size = 13, Center = true, Outline = true }),
        HealthBG = createDrawing("Square", { Filled = true, Color = Color3.new(0, 0, 0) }),
        HealthFG = createDrawing("Square", { Filled = true, Color = Color3.fromRGB(0, 255, 0) }),
        Skeleton = {},
    }
    for i = 1, 14 do
        ESPDrawings[player].Skeleton[i] = createDrawing("Line", { Thickness = 1 })
    end
    return ESPDrawings[player]
end

local SKELETON_BONES = {
    { "Head", "UpperTorso" },
    { "UpperTorso", "LowerTorso" },
    { "UpperTorso", "LeftUpperArm" },
    { "LeftUpperArm", "LeftLowerArm" },
    { "LeftLowerArm", "LeftHand" },
    { "UpperTorso", "RightUpperArm" },
    { "RightUpperArm", "RightLowerArm" },
    { "RightLowerArm", "RightHand" },
    { "LowerTorso", "LeftUpperLeg" },
    { "LeftUpperLeg", "LeftLowerLeg" },
    { "LeftLowerLeg", "LeftFoot" },
    { "LowerTorso", "RightUpperLeg" },
    { "RightUpperLeg", "RightLowerLeg" },
    { "RightLowerLeg", "RightFoot" },
}

local function updateESP()
    if not State.ESPEnabled then
        for player in pairs(ESPDrawings) do clearESP(player) end
        return
    end

    local camPos = Camera.CFrame.Position
    for _, player in ipairs(Players:GetPlayers()) do
        if isEnemy(player) then
            local char = getCharacter(player)
            local hrp = getRoot(player)
            local hum = getHumanoid(player)
            if char and hrp and hum then
                local dist = (hrp.Position - camPos).Magnitude
                if dist <= State.ESPMaxDistance then
                    local esp = ensureESP(player)

                    if State.ESPChams then
                        if not ESPHighlights[player] then
                            local h = Instance.new("Highlight")
                            h.FillColor = State.ESPChamsColor
                            h.OutlineColor = State.ESPChamsColor
                            h.FillTransparency = State.ESPChamsTransparency
                            h.OutlineTransparency = 0
                            h.Adornee = char
                            h.Parent = char
                            ESPHighlights[player] = h
                        else
                            ESPHighlights[player].FillColor = State.ESPChamsColor
                            ESPHighlights[player].OutlineColor = State.ESPChamsColor
                            ESPHighlights[player].FillTransparency = State.ESPChamsTransparency
                        end
                    elseif ESPHighlights[player] then
                        ESPHighlights[player]:Destroy()
                        ESPHighlights[player] = nil
                    end

                    local head = char:FindFirstChild("Head")
                    local headPos, headOn = worldToScreen(head and head.Position or hrp.Position + Vector3.new(0, 2, 0))
                    local footPos, footOn = worldToScreen(hrp.Position - Vector3.new(0, 3, 0))

                    if esp.Box and State.ESPBox and headOn and footOn then
                        local h = math.abs(headPos.Y - footPos.Y)
                        local w = h * 0.45
                        esp.Box.Size = Vector2.new(w, h)
                        esp.Box.Position = Vector2.new(headPos.X - w / 2, headPos.Y)
                        esp.Box.Color = State.ESPBoxColor
                        esp.Box.Thickness = State.ESPLineThickness
                        esp.Box.Visible = true
                    elseif esp.Box then
                        esp.Box.Visible = false
                    end

                    if esp.Tracer and State.ESPTracer and footOn then
                        local screenSize = Camera.ViewportSize
                        esp.Tracer.From = Vector2.new(screenSize.X / 2, screenSize.Y)
                        esp.Tracer.To = footPos
                        esp.Tracer.Color = State.ESPTracerColor
                        esp.Tracer.Thickness = State.ESPLineThickness
                        esp.Tracer.Visible = true
                    elseif esp.Tracer then
                        esp.Tracer.Visible = false
                    end

                    if esp.Name and State.ESPName and headOn then
                        esp.Name.Text = player.DisplayName
                        esp.Name.Position = Vector2.new(headPos.X, headPos.Y - 16)
                        esp.Name.Color = State.ESPNameColor
                        esp.Name.Visible = true
                    elseif esp.Name then
                        esp.Name.Visible = false
                    end

                    if esp.Distance and State.ESPDistance and headOn then
                        esp.Distance.Text = string.format("%dm", math.floor(dist))
                        esp.Distance.Position = Vector2.new(headPos.X, footPos.Y + 4)
                        esp.Distance.Color = State.ESPDistanceColor
                        esp.Distance.Visible = true
                    elseif esp.Distance then
                        esp.Distance.Visible = false
                    end

                    if esp.HealthBG and State.ESPHealth and headOn and footOn then
                        local h = math.abs(headPos.Y - footPos.Y)
                        local w = 3
                        local x = headPos.X - (h * 0.45) / 2 - 6
                        esp.HealthBG.Size = Vector2.new(w, h)
                        esp.HealthBG.Position = Vector2.new(x, headPos.Y)
                        esp.HealthBG.Visible = true
                        local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                        esp.HealthFG.Size = Vector2.new(w, h * pct)
                        esp.HealthFG.Position = Vector2.new(x, headPos.Y + h * (1 - pct))
                        esp.HealthFG.Visible = true
                    elseif esp.HealthBG then
                        esp.HealthBG.Visible = false
                        esp.HealthFG.Visible = false
                    end

                    if State.ESPSkeleton then
                        local idx = 1
                        for _, bone in ipairs(SKELETON_BONES) do
                            local p1 = char:FindFirstChild(bone[1])
                            local p2 = char:FindFirstChild(bone[2])
                            local line = esp.Skeleton[idx]
                            if line and p1 and p2 then
                                local s1, on1 = worldToScreen(p1.Position)
                                local s2, on2 = worldToScreen(p2.Position)
                                if on1 and on2 then
                                    line.From = s1
                                    line.To = s2
                                    line.Color = State.ESPSkeletonColor
                                    line.Thickness = State.ESPLineThickness
                                    line.Visible = true
                                else
                                    line.Visible = false
                                end
                            elseif line then
                                line.Visible = false
                            end
                            idx += 1
                        end
                    else
                        for _, line in ipairs(esp.Skeleton) do
                            if line then line.Visible = false end
                        end
                    end
                else
                    clearESP(player)
                end
            else
                clearESP(player)
            end
        else
            clearESP(player)
        end
    end
end

