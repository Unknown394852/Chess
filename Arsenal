            silentFOV.Transparency = 0.5
            silentFOV.Filled = false
            silentFOV.Visible = true
        else
            silentFOV.Visible = false
        end
    end
end

-- // Silent Aim Hook
local function getSilentTarget()
    if not State.SilentEnabled then return nil end
    if math.random(1, 100) > State.SilentHitChance then return nil end
    return getClosestPlayer(State.SilentFOV, State.SilentTargetPart, false)
end

local function installSilentHook()
    if SilentHookActive or not hookmetamethod then return end
    local old
    old = hookmetamethod(game, "__namecall", newcclosure and newcclosure(function(self, ...)
        local method = getnamecallmethod and getnamecallmethod() or ""
        if not checkcaller or checkcaller() then
            return old(self, ...)
        end
        if method == "Raycast" or method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" then
            local target = getSilentTarget()
            if target then
                local part = getTargetPart(target.Character, State.SilentTargetPart)
                if part then
                    local args = { ... }
                    if method == "Raycast" and #args >= 2 then
                        local dir = (part.Position - args[1]).Unit * args[2].Magnitude
                        args[2] = dir
                        return old(self, args[1], args[2], select(3, ...))
                    end
                end
            end
        end
        return old(self, ...)
    end) or function(self, ...)
        local method = getnamecallmethod and getnamecallmethod() or ""
        if method == "Raycast" then
            local target = getSilentTarget()
            if target then
                local part = getTargetPart(target.Character, State.SilentTargetPart)
                if part then
                    local args = { ... }
                    if #args >= 2 then
                        local dir = (part.Position - args[1]).Unit * args[2].Magnitude
                        return old(self, args[1], dir, select(3, ...))
                    end
                end
            end
        end
        return old(self, ...)
    end)
    SilentHook = old
    SilentHookActive = true
end

-- // Aimbot
local function runAimbot()
    if not State.AimbotEnabled then return end
    local active = State.AimbotMode == "Toggle" and State.AimbotActive or isKeyActive(State.AimbotKey, "Hold", false)
    if not active then return end
    local target = getClosestPlayer(State.AimbotFOV, State.AimbotTargetPart, State.AimbotWallCheck)
    if not target then return end
    local part = getTargetPart(target.Character, State.AimbotTargetPart)
    if not part then return end
    local pos = part.Position
    if State.AimbotRandomOffset > 0 then
        pos = pos + Vector3.new(
            math.random(-State.AimbotRandomOffset, State.AimbotRandomOffset) / 100,
            math.random(-State.AimbotRandomOffset, State.AimbotRandomOffset) / 100,
            math.random(-State.AimbotRandomOffset, State.AimbotRandomOffset) / 100
        )
    end
    local goal = CFrame.new(Camera.CFrame.Position, pos)
    if State.AimbotSmoothness <= 0 then
        Camera.CFrame = goal
    else
        Camera.CFrame = Camera.CFrame:Lerp(goal, math.clamp(1 / (State.AimbotSmoothness + 1), 0.01, 1))
    end
end

-- // Trigger Bot
local TriggerLastFire = 0

local function runTriggerBot()
    if not State.TriggerEnabled then return end
    local active = State.TriggerMode == "Toggle" and State.TriggerActive or isKeyActive(State.TriggerKey, "Hold", false)
    if not active then return end
    if tick() - TriggerLastFire < State.TriggerDelay then return end
    local target = Mouse.Target
    if not target then return end
    local char = target:FindFirstAncestorOfClass("Model")
    if not char then return end
    local player = Players:GetPlayerFromCharacter(char)
    if not player or not isEnemy(player) then return end
    if State.AimbotWallCheck and not isVisible(Camera.CFrame.Position, target) then return end
    TriggerLastFire = tick()
    if mouse1click then
        mouse1click()
    else
        pcall(function()
            VirtualUser:Button1Down(Vector2.new(0, 0))
            task.wait(0.05)
            VirtualUser:Button1Up(Vector2.new(0, 0))
        end)
    end
end

-- // Autofarm
local AutofarmRunning = false

local function equipWeapon(slot)
    local char = getCharacter()
    if not char then return end
    local hum = getHumanoid()
    if not hum then return end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return end
    local weapons = {}
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then table.insert(weapons, tool) end
    end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then table.insert(weapons, tool) end
    end
    local idx = slot == "Primary" and 1 or slot == "Secondary" and 2 or #weapons
    local tool = weapons[idx]
    if tool and tool.Parent == backpack then
        hum:EquipTool(tool)
    end
end

local function serverHop(lowPop)
    if not request then
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
        return
    end
    local url = string.format(
        "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100",
        game.PlaceId
    )
    local ok, resp = pcall(function()
        return request({ Url = url, Method = "GET" })
    end)
    if not ok or not resp or not resp.Body then
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
        return
    end
    local data = HttpService:JSONDecode(resp.Body)
    local best
    for _, server in ipairs(data.data or {}) do
        if server.id ~= game.JobId and server.playing < server.maxPlayers then
            if lowPop then
                if not best or server.playing < best.playing then
                    best = server
                end
            else
                best = server
                break
            end
        end
    end
    if best then
        TeleportService:TeleportToPlaceInstance(game.PlaceId, best.id, LocalPlayer)
    else
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    end
end

local function startAutofarm()
    if AutofarmRunning then return end
    AutofarmRunning = true
    task.spawn(function()
        while State.AutofarmEnabled and not Unloaded do
            if State.AutofarmAutoHop and #Players:GetPlayers() < State.AutofarmMinPlayers then
                serverHop(false)
                task.wait(5)
            else
                equipWeapon(State.AutofarmWeapon)
                local myRoot = getRoot()
                if myRoot then
                    for _, player in ipairs(Players:GetPlayers()) do
                        if not State.AutofarmEnabled then break end
                        if isEnemy(player) then
                            local targetRoot = getRoot(player)
                            local hum = getHumanoid(player)
                            if targetRoot and hum and hum.Health > 0 then
                                pcall(function()
                                    myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 4) * CFrame.Angles(0, math.pi, 0)
                                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetRoot.Position)
                                end)
                                for _ = 1, 3 do
                                    if mouse1click then mouse1click() end
                                    task.wait(0.05)
                                end
                                task.wait(State.AutofarmKillDelay)
                            end
                        end
                    end
                end
            end
            task.wait(0.25)
        end
        AutofarmRunning = false
    end)
end

-- // Player mods
local FlyBody = nil

local function setupFly()
    local char = getCharacter()
    local hrp = getRoot()
    if not hrp then return end
    if FlyBody then FlyBody:Destroy() end
    FlyBody = Instance.new("BodyVelocity")
    FlyBody.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    FlyBody.Velocity = Vector3.zero
    FlyBody.Parent = hrp
end

local function runFly()
    if not State.FlyEnabled or not FlyBody then return end
    local char = getCharacter()
    local hrp = getRoot()
    if not hrp then return end
    local move = Vector3.zero
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += Camera.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then move -= Camera.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then move -= Camera.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += Camera.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.new(0, 1, 0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move -= Vector3.new(0, 1, 0) end
    if move.Magnitude > 0 then move = move.Unit * State.FlySpeed end
    FlyBody.Velocity = move
end

local function applyPlayerMods()
    local hum = getHumanoid()
    if not hum then return end
    hum.WalkSpeed = State.WalkSpeedEnabled and State.WalkSpeed or 16
    if State.JumpPowerEnabled then hum.JumpPower = State.JumpPower end
end

-- // World mods
local function ensureWorldInstance(className, name)
    if WorldInstances[name] then return WorldInstances[name] end
    local inst = Lighting:FindFirstChild(name)
    if not inst then
        inst = Instance.new(className)
        inst.Name = name
        inst.Parent = Lighting
    end
    WorldInstances[name] = inst
    return inst
end

local function applyWorldMods()
    local cc = ensureWorldInstance("ColorCorrectionEffect", "Synlith_CC")
    cc.Enabled = State.ColorCorrectionEnabled
    cc.Saturation = State.Saturation
    cc.Brightness = State.Brightness
    cc.Contrast = State.Contrast

    local bloom = ensureWorldInstance("BloomEffect", "Synlith_Bloom")
    bloom.Enabled = State.BloomEnabled
    bloom.Intensity = State.BloomIntensity
    bloom.Size = State.BloomSize

    local dof = ensureWorldInstance("DepthOfFieldEffect", "Synlith_DOF")
    dof.Enabled = State.DOFEnabled
    dof.FarIntensity = State.DOFFarIntensity

    if State.Fullbright then
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.FogEnd = 100000
        Lighting.GlobalShadows = false
    end
    if State.NoFog then
        Lighting.FogEnd = 100000
    end
    if State.RemoveShadows then
        Lighting.GlobalShadows = false
    end
end

local function applyFPSBoost()
    if not State.FPSBoost then return end
    local settings = settings and settings() or nil
    if settings and settings().Rendering then
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level01
    end
    for _, obj in ipairs(Lighting:GetChildren()) do
        if obj:IsA("PostEffect") and obj.Name:sub(1, 8) ~= "Synlith_" then
            obj.Enabled = false
        end
    end
end

