-- // Hitbox Expander
local function restoreHitbox(player)
    local stored = HitboxOriginals[player]
    if not stored then return end
    for partName, props in pairs(stored) do
        local char = getCharacter(player)
        local part = char and char:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            part.CanCollide = props.CanCollide
            part.Transparency = props.Transparency
            part.Size = props.Size
        end
    end
    HitboxOriginals[player] = nil
end

local function extendHitbox(player)
    for _, partName in ipairs({ "UpperTorso", "Head", "HumanoidRootPart" }) do
        local char = getCharacter(player)
        local part = char and char:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            if not HitboxOriginals[player] then HitboxOriginals[player] = {} end
            if not HitboxOriginals[player][part.Name] then
                HitboxOriginals[player][part.Name] = {
                    CanCollide = part.CanCollide,
                    Transparency = part.Transparency,
                    Size = part.Size,
                }
            end
            part.CanCollide = false
            part.Transparency = State.HitboxTransparency / 10
            part.Size = Vector3.new(State.HitboxSize, State.HitboxSize, State.HitboxSize)
        end
    end
end

local function updateAllHitboxes()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if State.HitboxEnabled and isEnemy(player) then
                extendHitbox(player)
            else
                restoreHitbox(player)
            end
        end
    end
end

-- // Gun Mods
local function iterateWeapons(callback)
    local weapons = ReplicatedStorage:FindFirstChild("Weapons")
    if not weapons then return end
    for _, desc in ipairs(weapons:GetDescendants()) do
        callback(desc)
    end
end

local function storeGunValue(container, key, inst, prop)
    if inst and inst:IsA("ValueBase") then
        if not container[key][inst] then
            container[key][inst] = inst.Value
        end
    end
end

local function applyGunMods()
    iterateWeapons(function(desc)
        if desc.Name == "FireRate" or desc.Name == "BFireRate" then
            storeGunValue(GunModOriginals, "FireRate", desc, "Value")
            if State.FastFireRate then desc.Value = 0.02 end
        elseif desc.Name == "ReloadTime" then
            storeGunValue(GunModOriginals, "ReloadTime", desc, "Value")
            if State.FastReload then desc.Value = 0.01 end
        elseif desc.Name == "EReloadTime" then
            storeGunValue(GunModOriginals, "EReloadTime", desc, "Value")
            if State.FastReload then desc.Value = 0.01 end
        elseif desc.Name == "Auto" or desc.Name == "Automatic" then
            storeGunValue(GunModOriginals, "Auto", desc, "Value")
            if State.AlwaysAuto then desc.Value = true end
        elseif desc.Name == "MaxSpread" or desc.Name == "Spread" then
            storeGunValue(GunModOriginals, "Spread", desc, "Value")
            if State.NoSpread then desc.Value = 0 end
        elseif desc.Name == "RecoilControl" or desc.Name == "Recoil" then
            storeGunValue(GunModOriginals, "Recoil", desc, "Value")
            if State.NoRecoil then desc.Value = 0 end
        end
    end)
end

local function restoreGunMods()
    for category, stored in pairs(GunModOriginals) do
        for inst, val in pairs(stored) do
            if inst.Parent then
                pcall(function() inst.Value = val end)
            end
        end
    end
end

