	noRecoil = false,
	originals = {},
}

local function modWeapons(modType, state)
	pcall(function()
		local weapons = ReplicatedStorage:FindFirstChild("Weapons")
		if not weapons then return end
		for _, desc in ipairs(weapons:GetDescendants()) do
			if not desc:IsA("NumberValue") and not desc:IsA("BoolValue") then continue end
			local name = desc.Name
			if not gunModState.originals[desc] then
				gunModState.originals[desc] = desc.Value
			end
			if modType == "reload" then
				if name == "ReloadTime" or name == "EReloadTime" then
					desc.Value = state and 0.01 or gunModState.originals[desc]
				end
			elseif modType == "firerate" then
				if name == "FireRate" or name == "BFireRate" then
					desc.Value = state and 0.02 or gunModState.originals[desc]
				end
			elseif modType == "auto" then
				if name == "Auto" or name == "Automatic" then
					desc.Value = state and true or gunModState.originals[desc]
				end
			elseif modType == "spread" then
				if name == "MaxSpread" or name == "Spread" then
					desc.Value = state and 0 or gunModState.originals[desc]
				end
			elseif modType == "recoil" then
				if name == "RecoilControl" or name == "Recoil" then
					desc.Value = state and 0 or gunModState.originals[desc]
				end
			end
		end
	end)
end

