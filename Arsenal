--// ═══════════════════════════════════════
--// AUTOFARM
--// ═══════════════════════════════════════

local autofarmThread = nil

local function startAutofarm()
	if autofarmThread then task.cancel(autofarmThread) end
	autofarmThread = task.spawn(function()
		while Settings.AutofarmEnabled and not unloaded do
			local enemies = {}
			for _, player in ipairs(Players:GetPlayers()) do
				if isEnemy(player) and isAlive(player) then
					table.insert(enemies, player)
				end
			end

			if #enemies == 0 then
				task.wait(0.5)
				if Settings.AutofarmAutoHop and #Players:GetPlayers() < 3 then
					pcall(function()
						TeleportService:Teleport(game.PlaceId, LocalPlayer)
					end)
				end
				continue
			end

			for _, enemy in ipairs(enemies) do
				if not Settings.AutofarmEnabled or unloaded then break end
				if not isAlive(enemy) then continue end

				local char = enemy.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				local head = char and char:FindFirstChild("Head")
				if not hrp or not head then continue end

				-- TP behind and lock
				local behindCF = hrp.CFrame * CFrame.new(0, 0, 3)
				if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
					local myHRP = LocalPlayer.Character.HumanoidRootPart

					-- Tween to stay glued behind
					for i = 1, 15 do
						if not Settings.AutofarmEnabled or unloaded then break end
						if not isAlive(enemy) then break end

						local enemyHRP = enemy.Character and enemy.Character:FindFirstChild("HumanoidRootPart")
						local enemyHead = enemy.Character and enemy.Character:FindFirstChild("Head")
						if not enemyHRP or not enemyHead then break end

						behindCF = enemyHRP.CFrame * CFrame.new(0, 0, 3)
						myHRP.CFrame = behindCF
						Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, enemyHead.Position)

						-- Auto shoot
						mouse1click()
						task.wait(0.05)
					end
				end

				task.wait(Settings.AutofarmDelay)
			end

			task.wait(0.1)
		end
	end)
end

