-- Aimbot Logic
local function getClosestPlayerToFOV()
	local closest, minDist = nil, math.huge
	local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
	local parts = {"Head", "UpperTorso", "HumanoidRootPart"}
	local targetPartName = aimbotState.targetPart

	for _, player in ipairs(getEnemies()) do
		local char = getCharacter(player)
		if not char then continue end

		local partName = targetPartName == "Random" and parts[math.random(1, #parts)] or targetPartName
		local part = char:FindFirstChild(partName) or char:FindFirstChild("HumanoidRootPart")
		if not part then continue end

		local screenPos, onScreen = worldToScreen(part.Position)
		if not onScreen then continue end

		local dist = (screenPos - center).Magnitude
		if dist > aimbotState.fovRadius then continue end

		if aimbotState.wallCheck and not isVisible(Camera.CFrame.Position, part.Position) then continue end

		if dist < minDist then
			closest = {player = player, part = part, partName = partName}
			minDist = dist
		end
	end
	return closest
end

