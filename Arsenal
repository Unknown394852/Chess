-- // Main loops & events
connect(UserInputService.InputBegan, function(input, processed)
    if processed then return end
    if State.AimbotMode == "Toggle" and inputMatchesBind(input, State.AimbotKey) then
        State.AimbotActive = not State.AimbotActive
    end
    if State.TriggerMode == "Toggle" and inputMatchesBind(input, State.TriggerKey) then
        State.TriggerActive = not State.TriggerActive
    end
    if State.InfiniteJump and input.KeyCode == Enum.KeyCode.Space then
        local hum = getHumanoid()
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

connect(RunService.RenderStepped, function()
    if Unloaded then return end
    runAimbot()
    runFly()
    updateFOVCircles()
    updateESP()
    applySkins()
    if State.FOVChangerEnabled then Camera.FieldOfView = State.FOVValue end
    if State.NoClip then
        local char = getCharacter()
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end
end)

connect(RunService.Heartbeat, function()
    if Unloaded then return end
    if State.TriggerEnabled then runTriggerBot() end
    if State.FastReload or State.FastFireRate or State.AlwaysAuto or State.NoSpread or State.NoRecoil then
        applyGunMods()
    end
    if State.InfiniteAmmo then setInfiniteAmmo(true) end
end)

connect(Players.PlayerAdded, function(player)
    connect(player.CharacterAdded, function()
        task.wait(0.5)
        if State.HitboxEnabled then extendHitbox(player) end
    end)
end)

connect(Players.PlayerRemoving, function(player)
    restoreHitbox(player)
    clearESP(player)
end)

for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        connect(player.CharacterAdded, function()
            task.wait(0.5)
            if State.HitboxEnabled then extendHitbox(player) end
        end)
    end
end

connect(LocalPlayer.CharacterAdded, function()
    task.wait(0.5)
    if State.FlyEnabled then setupFly() end
    applyPlayerMods()
end)

-- // Unload
local function unload()
    if Unloaded then return end
    Unloaded = true

    State.AimbotEnabled = false
    State.SilentEnabled = false
    State.TriggerEnabled = false
    State.HitboxEnabled = false
    State.AutofarmEnabled = false
    State.ESPEnabled = false
    State.FlyEnabled = false
    State.NoClip = false

    for _, c in ipairs(Connections) do pcall(function() c:Disconnect() end) end
    table.clear(Connections)

    for player in pairs(HitboxOriginals) do restoreHitbox(player) end
    restoreGunMods()
    setInfiniteAmmo(false)

    for player in pairs(ESPDrawings) do clearESP(player) end
    for _, circle in pairs(FOVCircles) do
        if circle then circle:Remove() end
    end

    if FlyBody then FlyBody:Destroy() end

    for _, inst in pairs(WorldInstances) do
        if inst then inst:Destroy() end
    end

    RunService:Set3dRenderingEnabled(true)
    if setfpscap then setfpscap(60) end

    if WatermarkGui then WatermarkGui:Destroy() end
    if KeybindsGui then KeybindsGui:Destroy() end
    if Window then Window:Destroy() end

    getgenv().SynlithHubLoaded = nil
    getgenv().SynlithHubUnload = nil
end

getgenv().SynlithHubLoaded = true
getgenv().SynlithHubUnload = unload

createWatermark()
createKeybindsMenu()

if State.AutoloadConfig and isfile and isfolder then
    local configs = ConfigManager:AllConfigs()
    if table.find(configs, State.AutoloadConfigName) then
        Window.CurrentConfig = ConfigManager:CreateConfig(State.AutoloadConfigName)
        pcall(function() Window.CurrentConfig:Load() end)
    end
end

