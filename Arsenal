-- ESP Render Loop
addConnection(RunService.RenderStepped:Connect(function()
	for player, o in pairs(espObjects) do
		local char = getCharacter(player)
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local head = char and char:FindFirstChild("Head")

		if not hrp or not hum or hum.Health <= 0 then
			hideESP(o)
			continue
		end

		local myHRP = getHRP(LocalPlayer)
		if not myHRP then hideESP(o) continue end

		local dist = (hrp.Position - myHRP.Position).Magnitude
		if dist > espState.maxDistance then hideESP(o) continue end

		local screenPos, onScreen, depth = worldToScreen(hrp.Position)
		if not onScreen or depth < 0 then hideESP(o) continue end

		local scaleFactor = 1 / depth * 1000
		local boxW = math.clamp(40 * scaleFactor, 10, 200)
		local boxH = math.clamp(60 * scaleFactor, 15, 300)

		-- Box ESP
		o.box.Visible = espState.box
		if espState.box then
			o.box.Position = Vector2.new(screenPos.X - boxW / 2, screenPos.Y - boxH / 2)
			o.box.Size = Vector2.new(boxW, boxH)
			o.box.Color = espState.boxColor
			o.box.Thickness = espState.lineThickness
		end

		-- Tracer
		o.tracer.Visible = espState.tracer
		if espState.tracer then
			o.tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
			o.tracer.To = Vector2.new(screenPos.X, screenPos.Y + boxH / 2)
			o.tracer.Color = espState.tracerColor
			o.tracer.Thickness = espState.lineThickness
		end

		-- Name
		o.name.Visible = espState.name
		if espState.name and head then
			local headScreen = worldToScreen(head.Position + Vector3.new(0, 2.5, 0))
			o.name.Position = Vector2.new(screenPos.X, screenPos.Y - boxH / 2 - 18)
			o.name.Text = player.DisplayName
			o.name.Color = espState.nameColor
		end

		-- Distance
		o.dist.Visible = espState.distance
		if espState.distance then
			o.dist.Position = Vector2.new(screenPos.X, screenPos.Y + boxH / 2 + 3)
			o.dist.Text = math.floor(dist) .. "m"
			o.dist.Color = espState.distanceColor
		end

		-- Health Bar
		o.healthBg.Visible = espState.healthBar
		o.healthBar.Visible = espState.healthBar
		if espState.healthBar then
			local barH = boxH
			local barW = 3
			local healthPct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
			o.healthBg.Position = Vector2.new(screenPos.X - boxW / 2 - 6, screenPos.Y - boxH / 2)
			o.healthBg.Size = Vector2.new(barW, barH)
			o.healthBar.Position = Vector2.new(screenPos.X - boxW / 2 - 6, screenPos.Y - boxH / 2 + barH * (1 - healthPct))
			o.healthBar.Size = Vector2.new(barW, barH * healthPct)
			o.healthBar.Color = Color3.fromRGB(255 * (1 - healthPct), 255 * healthPct, 0)
		end

		-- Skeleton
		for i = 1, 12 do o.sk[i].Visible = false end
		if espState.skeleton then
			local bones = {
				{"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
				{"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
				{"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
				{"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"},
				{"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"},
			}
			for i, bone in ipairs(bones) do
				local p1 = char:FindFirstChild(bone[1])
				local p2 = char:FindFirstChild(bone[2])
				if p1 and p2 then
					local s1, v1 = worldToScreen(p1.Position)
					local s2, v2 = worldToScreen(p2.Position)
					if v1 and v2 then
						o.sk[i].From = s1
						o.sk[i].To = s2
						o.sk[i].Color = espState.skeletonColor
						o.sk[i].Thickness = espState.lineThickness
						o.sk[i].Visible = true
					end
				end
			end
		end

		-- Chams (Highlight)
		if espState.chams then
			local highlight = char:FindFirstChildOfClass("Highlight")
			if not highlight then
				highlight = Instance.new("Highlight")
				highlight.Name = "SynlithChams"
				highlight.FillColor = espState.chamsColor
				highlight.FillTransparency = 0.5
				highlight.OutlineColor = espState.chamsColor
				highlight.OutlineTransparency = 0
				highlight.Adornee = char
				highlight.Parent = char
			else
				highlight.FillColor = espState.chamsColor
				highlight.OutlineColor = espState.chamsColor
			end
		else
			if char then
				local h = char:FindFirstChild("SynlithChams")
				if h then h:Destroy() end
			end
		end
	end
end))

