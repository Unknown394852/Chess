local function createESPForPlayer(player)
	if player == LocalPlayer then return end
	if espObjects[player] then return end

	espObjects[player] = {
		box = Drawing.new("Square"),
		topLine = Drawing.new("Line"),
		tracer = Drawing.new("Line"),
		name = Drawing.new("Text"),
		dist = Drawing.new("Text"),
		healthBg = Drawing.new("Square"),
		healthBar = Drawing.new("Square"),
		-- Skeleton lines
		sk = {},
	}

	local o = espObjects[player]
	o.box.Visible = false; o.box.Filled = false; o.box.Thickness = 1.5
	o.tracer.Visible = false; o.tracer.Thickness = 1.5
	o.name.Visible = false; o.name.Size = 13; o.name.Center = true; o.name.Outline = true; o.name.Font = Drawing.Fonts.UI
	o.dist.Visible = false; o.dist.Size = 12; o.dist.Center = true; o.dist.Outline = true; o.dist.Font = Drawing.Fonts.UI
	o.healthBg.Visible = false; o.healthBg.Filled = true; o.healthBg.Color = Color3.fromRGB(30, 30, 30)
	o.healthBar.Visible = false; o.healthBar.Filled = true

	for i = 1, 12 do
		o.sk[i] = Drawing.new("Line")
		o.sk[i].Visible = false
		o.sk[i].Thickness = 1.5
	end
end

local function removeESPForPlayer(player)
	if espObjects[player] then
		for _, v in pairs(espObjects[player]) do
			if type(v) == "table" then
				for _, l in pairs(v) do pcall(function() l:Remove() end) end
			else
				pcall(function() v:Remove() end)
			end
		end
		espObjects[player] = nil
	end
end

local function hideESP(o)
	o.box.Visible = false
	o.tracer.Visible = false
	o.name.Visible = false
	o.dist.Visible = false
	o.healthBg.Visible = false
	o.healthBar.Visible = false
	for _, l in pairs(o.sk) do l.Visible = false end
end

