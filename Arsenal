	Callback = function()
		-- Clean up all connections
		for _, conn in ipairs(Connections) do
			pcall(function() conn:Disconnect() end)
		end

		-- Clean up ESP drawings
		for player, o in pairs(espObjects) do
			removeESPForPlayer(player)
		end

		-- Clean up Drawing objects
		pcall(function() fovCircle:Remove() end)
		pcall(function() silentFOV:Remove() end)

		-- Clean up fly
		if flyBP then flyBP:Destroy() end
		if flyBG then flyBG:Destroy() end

		-- Clean up lighting effects
		pcall(function() if ccEffect then ccEffect:Destroy() end end)
		pcall(function() if bloomEffect then bloomEffect:Destroy() end end)
		pcall(function() if dofEffect then dofEffect:Destroy() end end)

		-- Restore rendering
		pcall(function() RunService:Set3dRenderingEnabled(true) end)

		-- Reset gun mods
		for desc, orig in pairs(gunModState.originals) do
			pcall(function() desc.Value = orig end)
		end

		-- Reset hitboxes
		for player, _ in pairs(silentState.original) do
			resetHitbox(player)
		end

		-- Unload UI
		Window:Unload()
	end,
})

--// ============================================
--// INITIALIZATION
--// ============================================
CombatTab:Select()
MacLib:LoadAutoLoadConfig()

Window:Notify({
	Title = "Synlith Hub",
	Description = "Arsenal script loaded successfully. Press RightCtrl to toggle menu.",
	Lifetime = 5,
	Style = "Confirm",
})
