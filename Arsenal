local chamsObjects = {}

local function updateChams()
	for _, player in ipairs(Players:GetPlayers()) do
		if player == LocalPlayer then continue end
		local char = player.Character
		if not char or not isEnemy(player) then
			if chamsObjects[player] then
				chamsObjects[player]:Destroy()
				chamsObjects[player] = nil
			end
			continue
		end

		if Settings.ESPChams then
			if not chamsObjects[player] then
				local highlight = Instance.new("Highlight")
				highlight.FillColor = Settings.ESPChamsColor
				highlight.OutlineColor = Settings.ESPChamsColor
				highlight.FillTransparency = 0.5
				highlight.OutlineTransparency = 0.3
				highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				highlight.Adornee = char
				highlight.Parent = char
				chamsObjects[player] = highlight
			else
				chamsObjects[player].FillColor = Settings.ESPChamsColor
				chamsObjects[player].OutlineColor = Settings.ESPChamsColor
			end
		else
			if chamsObjects[player] then
				chamsObjects[player]:Destroy()
				chamsObjects[player] = nil
			end
		end
	end
end

AddConnection(RunService.Heartbeat:Connect(updateChams))

