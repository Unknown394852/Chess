local function applySkins()
    local arms = getArms()
    if not arms then return end
    local armMat = MATERIAL_MAP[State.ArmMaterial] or Enum.Material.Plastic
    local gunMat = MATERIAL_MAP[State.GunMaterial] or Enum.Material.Plastic
    local t = tick()
    local armColor = State.ArmRainbow and Color3.fromHSV((t * 0.2) % 1, 1, 1) or State.ArmColor
    local gunColor = State.GunRainbow and Color3.fromHSV((t * 0.2 + 0.5) % 1, 1, 1) or State.GunColor

