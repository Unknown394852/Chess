-- Skins Logic
local skinHue = 0
addConnection(RunService.RenderStepped:Connect(function(dt)
	skinHue = (skinHue + dt * 0.5) % 1
	local rainbowColor = Color3.fromHSV(skinHue, 1, 1)

	pcall(function()
		local arms = Camera:FindFirstChild("Arms")
		if not arms then return end

		for _, child in ipairs(arms:GetChildren()) do
			if child.Name == "Right Arm" or child.Name == "Left Arm" then
				child.Material = materialMap[skinState.armMaterial] or Enum.Material.Plastic
				child.Color = skinState.armRainbow and rainbowColor or skinState.armColor
			elseif child:IsA("MeshPart") then
				child.Material = materialMap[skinState.gunMaterial] or Enum.Material.Plastic
				child.Color = skinState.gunRainbow and rainbowColor or skinState.gunColor
			end
		end
	end)
end))

