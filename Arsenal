addConnection(RunService.RenderStepped:Connect(function(dt)
	-- FOV Circle
	local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
	fovCircle.Position = center
	fovCircle.Visible = aimbotState.enabled and aimbotState.drawFOV

	if not aimbotState.enabled or not aimbotState.active then return end
	if not isAlive(LocalPlayer) then return end

	local target = getClosestPlayerToFOV()
	if not target then return end

	local targetPos = target.part.Position
	-- Prediction
	if aimbotState.prediction then
		local hrp = target.part.Parent:FindFirstChild("HumanoidRootPart")
		if hrp then
			local velocity = hrp.AssemblyLinearVelocity
			local distance = (Camera.CFrame.Position - targetPos).Magnitude
			local bulletSpeed = 1000
			local travelTime = distance / bulletSpeed
			targetPos = targetPos + velocity * travelTime
		end
	end

	-- Random offset
	if aimbotState.randomOffset > 0 then
		local r = aimbotState.randomOffset
		targetPos = targetPos + Vector3.new(
			math.random(-r * 100, r * 100) / 100,
			math.random(-r * 100, r * 100) / 100,
			math.random(-r * 100, r * 100) / 100
		)
	end

	-- Smoothness
	local targetCF = CFrame.new(Camera.CFrame.Position, targetPos)
	if aimbotState.smoothness > 0 then
		local alpha = math.clamp(1 / (aimbotState.smoothness + 1), 0.01, 1)
		Camera.CFrame = Camera.CFrame:Lerp(targetCF, alpha)
	else
		Camera.CFrame = targetCF
	end
end))

